#!/usr/bin/env bash
# Refuse to push a release tag whose name disagrees with the plugin manifest.
#
# The failure this exists to stop: burnrate's cache directory under
# <config>/plugins/cache is keyed on .claude-plugin/plugin.json's version, so a
# release that ships code without bumping that string is invisible to every
# installed copy. `claude plugin update` compares versions, sees no change, and
# correctly does nothing. v0.1.1 and v0.1.2 both shipped that way and reached
# nobody. A tag IS the release, so the tag push is the one moment where the
# check cannot be skipped or forgotten.
#
# Install once per clone (CONTRIBUTING says so too):
#     git config core.hooksPath .githooks
set -uo pipefail

ZERO='0000000000000000000000000000000000000000'
status=0

while read -r _localref localsha remoteref _remotesha; do
    case "$remoteref" in refs/tags/v*) ;; *) continue ;; esac
    [ "$localsha" = "$ZERO" ] && continue          # tag deletion

    tag=${remoteref#refs/tags/}
    commit=$(git rev-parse --quiet --verify "${localsha}^{commit}") || continue
    manifest=$(git show "${commit}:.claude-plugin/plugin.json" 2>/dev/null) || {
        printf 'pre-push: %s has no .claude-plugin/plugin.json\n' "$tag" >&2
        status=1
        continue
    }
    version=$(printf '%s' "$manifest" |
        sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)

    if [ -z "$version" ]; then
        printf 'pre-push: %s: plugin.json declares no version\n' "$tag" >&2
        status=1
    elif [ "$tag" != "v${version}" ]; then
        printf 'pre-push: refusing to push %s\n' "$tag" >&2
        printf '  plugin.json at that commit says %s, so the tag must be v%s.\n' \
               "$version" "$version" >&2
        printf '  A tag that outruns the manifest ships to nobody: the plugin\n' >&2
        printf '  cache is version-keyed and never refetches an unchanged one.\n' >&2
        printf '  Bump .claude-plugin/plugin.json, or retag to v%s.\n' "$version" >&2
        status=1
    fi
done

exit "$status"
